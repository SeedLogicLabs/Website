# Copy to .env.local for local development. Never commit .env.local.

# Neon Postgres connection string (Phase 2 forms). Server-only.
DATABASE_URL=

# Random salt for hashing visitor IPs before storage. Generate: openssl rand -hex 32
IP_HASH_SALT=

# Cloudflare Web Analytics site token. Leave empty to disable the beacon.
NEXT_PUBLIC_CF_BEACON_TOKEN=
